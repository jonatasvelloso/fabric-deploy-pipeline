table fato_vendas
	lineageTag: 2a6d9c1e-4b7f-4e3a-8d5c-9b1f6e3a7d22

	measure Receita = SUM(fato_vendas[receita])
		formatString: R$ #,0.00
		lineageTag: 7c3e1a9d-5f2b-4d8c-a6e1-4b9d7f3c1e23

	measure 'Ticket Medio' = DIVIDE([Receita], SUM(fato_vendas[quantidade]))
		formatString: R$ #,0.00
		lineageTag: 9e5b3d7f-1a4c-4f2e-b8d6-6c1e9a5b3f24

	column data_pedido
		dataType: dateTime
		sourceColumn: data_pedido
		lineageTag: 1d7f3b9e-6c2a-4e5d-9f8b-2a4c6e8d1b25

	column produto_id
		dataType: string
		sourceColumn: produto_id
		lineageTag: 4f9a2c6e-8d1b-4b7f-a3e5-7c9e1d3f5a26

	column quantidade
		dataType: int64
		sourceColumn: quantidade
		lineageTag: 6b2e8d4a-3f9c-4a1e-b7d5-1f3a5c7e9b27

	column receita
		dataType: decimal
		sourceColumn: receita
		lineageTag: 8d4a6f2c-9e1b-4c3f-a5d7-3b5d7f9a1c28

	partition fato_vendas = entity
		mode: directLake
		source
			entityName: fato_vendas
			expressionSource: DatabaseQuery
